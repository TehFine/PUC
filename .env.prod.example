# Cấu hình cơ sở dữ liệu PostgreSQL + PostGIS trong Docker
POSTGRES_USER=puc_user
POSTGRES_PASSWORD=Thay_Bang_Mat_Khau_DB_Manh_2026
POSTGRES_DB=puc_cune

# Khi CHƯA có tên miền (truy cập qua http://<IP_MAY_CHU>):
# Để BACKEND_NODE_ENV=development và COOKIE_SECURE=false để trình duyệt lưu được phiên đăng nhập qua HTTP.
# Khi ĐÃ mua tên miền htxcune.com và bật HTTPS:
# Đổi thành BACKEND_NODE_ENV=production, COOKIE_SECURE=true và CORS_ORIGIN=https://htxcune.com
BACKEND_NODE_ENV=development
COOKIE_SECURE=false
CORS_ORIGIN=http://IP_MAY_CHU_CUA_BAN

# Hai khóa bí mật tối thiểu 32 ký tự ngẫu nhiên (sinh bằng lệnh openssl rand -base64 48)
JWT_ACCESS_SECRET=Thay_Bang_Chuoi_Ngau_Nhien_Dai_48_Ky_Tu_1
TOTP_ENCRYPTION_KEY=Thay_Bang_Chuoi_Ngau_Nhien_Dai_48_Ky_Tu_2

UPLOAD_MAX_MB=20


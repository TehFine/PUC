# Cấu hình cơ sở dữ liệu PostgreSQL + PostGIS trong Docker
POSTGRES_USER=puc_user
POSTGRES_PASSWORD=Thay_Bang_Mat_Khau_DB_Manh_2026
POSTGRES_DB=puc_cune

# Tên miền chính thức dùng để cấp chứng chỉ SSL Let's Encrypt và bật cổng 443 trên Nginx
SSL_DOMAIN=htxcune.com

# Cấu hình mặc định an toàn cho môi trường Production (HTTPS).
# Lưu ý: Chỉ khi chạy thử nghiệm nội bộ tạm thời qua HTTP chưa có chứng chỉ SSL mới đặt COOKIE_SECURE=false.
BACKEND_NODE_ENV=production
COOKIE_SECURE=true
CORS_ORIGIN=https://htxcune.com,https://www.htxcune.com

# Hai khóa bí mật tối thiểu 32 ký tự ngẫu nhiên (sinh bằng lệnh openssl rand -base64 48)
JWT_ACCESS_SECRET=Thay_Bang_Chuoi_Ngau_Nhien_Dai_48_Ky_Tu_1
TOTP_ENCRYPTION_KEY=Thay_Bang_Chuoi_Ngau_Nhien_Dai_48_Ky_Tu_2

UPLOAD_MAX_MB=20

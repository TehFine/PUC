NODE_ENV=development
PORT=4000
# Ở NODE_ENV=development, hệ thống tự động chấp nhận thêm localhost/127.0.0.1 cổng 3000..3010 khi next dev tự đổi cổng
CORS_ORIGIN=http://localhost:3000

# PostgreSQL + PostGIS (khớp docker-compose.yml ở thư mục gốc)
DATABASE_URL=postgres://htx:htx_dev_password@localhost:5432/htx
# Mặc định tự động tắt TLS với localhost/db cục bộ và bắt buộc bật TLS với CSDL từ xa trên production:
# DATABASE_SSL=false
# Mặc định bật mã hóa TLS cho mọi CSDL đám mây (Supabase Pooler, Render Postgres...); chỉ bật đối chiếu CA gốc khi đặt true hoặc truyền DATABASE_CA_CERT:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_CA_CERT=

# Tạo khóa thật bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-in-dev-only-generate-48-random-bytes-for-prod
# Khóa gốc riêng (tùy chọn, tối thiểu 32 ký tự) để mã hóa khóa TOTP 2 lớp bằng AES-256-GCM và làm pepper HMAC cho mã dự phòng.
# Nếu để trống, hệ thống dẫn xuất khóa tách biệt từ JWT_ACCESS_SECRET qua HKDF-SHA256.
# TOTP_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Bắt buộc true khi chạy production (HTTPS); chỉ để trống hoặc false khi chạy localhost HTTP
# COOKIE_SECURE=true

# Danh sách proxy tin cậy để đọc X-Forwarded-For (bắt buộc khai báo tường minh trên production, không được đặt 'true'):
# - Localhost hoặc máy chủ không đứng sau proxy: loopback
# - Sau 1 reverse proxy tin cậy (Render / Nginx): 1
# - Đi qua Vercel rewrite (/api/*) sang Render LB (2 bước nhảy): 2
#   Lưu ý bảo mật: chỉ đặt TRUST_PROXY=2 khi origin Backend chỉ nhận lưu lượng từ lớp proxy phía trước (hoặc giới hạn dải IP),
#   tránh để kẻ tấn công gọi thẳng vào origin kèm header X-Forwarded-For giả mạo để vượt giới hạn tần suất.
TRUST_PROXY=loopback

# Ngưỡng Rate Limit đa tầng (tùy chọn, đã có mặc định an toàn):
# RATE_LIMIT_BURST_MAX=120
# RATE_LIMIT_DEFAULT_MAX=240
# RATE_LIMIT_WRITE_MAX=60
# RATE_LIMIT_MAX_KEYS=25000

# Trần số khóa bộ nhớ đệm L1 trên RAM (tùy chọn, mặc định 4000):
# CACHE_MAX_KEYS=4000

# Tùy chọn Google OAuth thật (để trống nếu chưa bật đăng nhập Google)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# ALLOW_DEV_DEMO_LOGIN=false

# Chỉ dùng cho `npm run db:seed` (môi trường dev): mật khẩu của các tài khoản mẫu
SEED_PASSWORD=Htx@12345

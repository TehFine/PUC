NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL + PostGIS (khớp docker-compose.yml ở thư mục gốc)
DATABASE_URL=postgres://htx:htx_dev_password@localhost:5432/htx
DATABASE_SSL=false
# Mặc định true trên production; đặt false chỉ khi dùng proxy CSDL nội bộ tự ký
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Tạo khóa thật bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-in-dev-only-generate-48-random-bytes-for-prod
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Đặt true khi chạy HTTPS (production) để cookie chỉ gửi qua kết nối an toàn
COOKIE_SECURE=false

# Danh sách proxy tin cậy để đọc X-Forwarded-For (mặc định chỉ loopback)
TRUST_PROXY=loopback

# Tùy chọn Google OAuth thật (để trống nếu chưa bật đăng nhập Google)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# ALLOW_DEV_DEMO_LOGIN=false

# Chỉ dùng cho `npm run db:seed` (môi trường dev): mật khẩu của các tài khoản mẫu
SEED_PASSWORD=Htx@12345

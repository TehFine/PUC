NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL + PostGIS (khớp docker-compose.yml ở thư mục gốc)
DATABASE_URL=postgres://htx:htx_dev_password@localhost:5432/htx
DATABASE_SSL=false
# Trên production bắt buộc kiểm tra chứng chỉ TLS (true); nếu dùng Supabase/RDS CA riêng, truyền PEM hoặc base64 PEM vào DATABASE_CA_CERT.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_CA_CERT=

# Tạo khóa thật bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-in-dev-only-generate-48-random-bytes-for-prod
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Bắt buộc true khi chạy production (HTTPS); chỉ để trống hoặc false khi chạy localhost HTTP
# COOKIE_SECURE=true

# Danh sách proxy tin cậy để đọc X-Forwarded-For:
# - Localhost: loopback
# - Sau 1 reverse proxy (Render / Nginx): 1
# - Đi qua Vercel rewrite (/api/*) sang Render LB (2 bước nhảy): 2
TRUST_PROXY=loopback

# Ngưỡng Rate Limit đa tầng (tùy chọn, đã có mặc định an toàn):
# RATE_LIMIT_BURST_MAX=120
# RATE_LIMIT_DEFAULT_MAX=240
# RATE_LIMIT_WRITE_MAX=60
# RATE_LIMIT_MAX_KEYS=25000

# Trần số khóa bộ nhớ đệm L1 trên RAM (tùy chọn, mặc định 4000):
# CACHE_MAX_KEYS=4000

# Tùy chọn Google OAuth thật (để trống nếu chưa bật đăng nhập Google)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# ALLOW_DEV_DEMO_LOGIN=false

# Chỉ dùng cho `npm run db:seed` (môi trường dev): mật khẩu của các tài khoản mẫu
SEED_PASSWORD=Htx@12345

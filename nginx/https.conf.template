# Bộ đệm tài nguyên tĩnh & ảnh tối ưu AVIF/WebP ngay tại Nginx (giảm tải Node.js & rút ngắn LCP)
proxy_cache_path /var/cache/nginx/puc_cache levels=1:2 keys_zone=puc_static_cache:16m max_size=512m inactive=7d use_temp_path=off;

map $http_accept $puc_img_accept {
    default          "*/*";
    "~*image/avif"   "image/avif,image/webp,*/*";
    "~*image/webp"   "image/webp,*/*";
}

# Khối nội bộ cho lệnh kiểm tra sức khỏe từ máy chủ cục bộ (127.0.0.1) trong GitHub Actions
server {
    listen 80;
    server_name 127.0.0.1 localhost;
    server_tokens off;

    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;

    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    location /api/ {
        set $backend_upstream http://backend:4000;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $frontend_upstream http://frontend:3000;
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Cổng 80 công khai: phục vụ gia hạn chứng chỉ Let's Encrypt và tự động chuyển hướng sang HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Cổng 443 HTTPS chính thức (HTTP/2 + Gzip + Bộ đệm ảnh AVIF/WebP & gói tĩnh)
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/__SSL_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SSL_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 25M;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/x-javascript
        application/json
        application/manifest+json
        application/xml
        image/svg+xml;

    # Mở rộng bộ đệm đọc header phản hồi (Next.js gửi kèm CSP nonce + Link preload phông chữ vượt mức 4k mặc định của Nginx)
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;

    # Dùng DNS nội bộ của Docker (127.0.0.11) để tự cập nhật IP mới khi container frontend/backend được build lại
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    # Kênh đẩy sự kiện thời gian thực (SSE): tắt nén và bộ đệm để chuyển tiếp tức thời
    location ~ ^/api/(notifications/stream|public/trace-stream)$ {
        set $backend_upstream http://backend:4000;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        gzip off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # Chuyển thẳng mọi yêu cầu API sang container NestJS Backend
    location /api/ {
        set $backend_upstream http://backend:4000;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Bộ đệm gói JS/CSS/Font bất biến của Next.js
    location ^~ /_next/static/ {
        set $frontend_upstream http://frontend:3000;
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache puc_static_cache;
        proxy_cache_key "$request_uri";
        proxy_cache_valid 200 365d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
    }

    # Bộ đệm ảnh tối ưu AVIF/WebP của Next.js (phân tách chuẩn theo định dạng trình duyệt hỗ trợ)
    location ^~ /_next/image {
        set $frontend_upstream http://frontend:3000;
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept $puc_img_accept;
        proxy_cache puc_static_cache;
        proxy_cache_key "$request_uri:$puc_img_accept";
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
    }

    # Bộ đệm ảnh tĩnh công khai trong thư mục public/
    location ~* ^/(landing|stages|varieties|training|diseases|pesticides|fertilizers|icons)/ {
        set $frontend_upstream http://frontend:3000;
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache puc_static_cache;
        proxy_cache_key "$request_uri";
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
    }

    # Chuyển giao diện người dùng sang container Next.js Frontend (giữ nguyên CSP nonce theo từng request)
    location / {
        set $frontend_upstream http://frontend:3000;
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
